#include <windows.h>

#define ID_PAYLOAD 201
#define ID_ICONE   202

// O programa completo, embutido dentro do instalador.
ID_PAYLOAD RCDATA "..\\dist\\Curso de Java.exe"
ID_ICONE   ICON   "curso.ico"

1 RT_MANIFEST "instalador.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Renato Chong"
            VALUE "FileDescription",  "Instalador do Curso de Java"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "curso-java-setup"
            VALUE "OriginalFilename", "Instalar Curso de Java.exe"
            VALUE "ProductName",      "Curso de Java"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Material de estudo de uso livre"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
